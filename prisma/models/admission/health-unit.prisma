model HealthUnit {
    id        Int      @id @default(autoincrement())
    unit_name String
    unit_type String

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    // Parents
    session      Int
    academic_year AcademicYear @relation(fields: [session], references: [id])

    // Children
    health_masters HealthMaster[]
}