model HealthMaster {
    id               Int      @id @default(autoincrement())
    health_parameter String

    created_at        DateTime @default(now())
    updated_at        DateTime @updatedAt

    // Parents
    session      Int
    academic_year AcademicYear @relation(fields: [session], references: [id])
    unit         Int
    health_unit   HealthUnit   @relation(fields: [unit], references: [id])

    // Children
}