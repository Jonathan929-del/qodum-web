model GeneralLedger {
  id                   Int      @id @default(autoincrement())
  account_name         String
  account_type         String
  opening_balance      Float?
  opening_balance_type BalanceType?
  assign_date          DateTime?
  is_cash_book         Boolean?
  is_fixed_asset       Boolean?
  depreciation         Float?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  // Parents
  session      Int
  academic_year AcademicYear @relation(fields: [session], references: [id])
  group        Int
  account_group AccountGroup @relation(fields: [group], references: [id])

  // Children
  stationary_details StationaryDetails[]
}