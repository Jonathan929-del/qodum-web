model StaffAdmissionNumber {
  id           Int       @id @default(autoincrement())
  setting_type String?
  should_be    ShouldBe?
  rec_no       Int?
  prefix       String?
  start_from   Int?
  lead_zero    String?
  suffix       String?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  // Parents
  session       Int
  academic_year AcademicYear @relation(fields: [session], references: [id])

  // Children
}